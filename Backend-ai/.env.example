# Copy to .env and fill in GEMINI_API_KEY. Everything else has a working
# default. .env must stay in .gitignore — never commit it.

# --- Required ---
GEMINI_API_KEY=

# --- Models ---
# "prompted" or "transcribe". Stay on prompted — the dedicated endpoint takes
# no prompt, so it loses the loanword rule and catalog biasing.
ASR_BACKEND=prompted
ASR_PROMPTED_MODEL=gemini-3.5-flash-lite
ASR_TRANSCRIBE_MODEL=gemini-3.5-transcribe
EXTRACTION_MODEL=gemini-3.5-flash-lite

# 0 makes the same audio give the same record every run.
TEMPERATURE=0

# --- Clarification loop ---
MAX_FOLLOWUP_ATTEMPTS=3
MAX_ITEMS=10

# --- Product name matching ---
MAX_CATALOG_HINTS=40
CATALOG_MATCH_THRESHOLD=0.72

# --- Currency ---
# Set to 0 to ask every time instead of inferring from the amount.
CURRENCY_INFER=1
KHR_MIN_PRICE=1000
USD_MAX_PRICE=99

# --- Payment ---
DEFAULT_PAYMENT_METHOD=cash

# --- Network ---
MAX_RETRIES=2
RETRY_BASE_DELAY_S=0.75